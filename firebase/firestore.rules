rules_version = '2';

// Nexus Social — regole Firestore (Fase A.1: rafforzamento privacy).
//
// Principi:
//  • Firestore restituisce sempre il documento intero: per questo ogni lettura singola
//    (get) rivalida allowlist dei campi e tipi, anche sui documenti legacy scritti con
//    regole precedenti. Un documento con campi extra o strutture annidate non previste
//    non è leggibile.
//  • Le query (list) non possono rivalidare il contenuto dei documenti ("rules are not
//    filters"): sono consentite solo su documenti con schemaVersion == 2, che possono
//    esistere solo se scritti con queste regole, e la query deve filtrare su quel campo.
//  • Le chat contengono solo testo cifrato lato dispositivo (ciphertext + iv in base64).
//  • L'appartenenza a una chat sta in chats/{chatId}/members/{uid}: owner, admin, member.
//    Un utente rimosso perde subito l'accesso; il reinvito crea una nuova membership.
//  • Tutto ciò che non è previsto è negato.
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Identità ───────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ─── Validatori di base ─────────────────────────────────────────────────

    function isUid(v) {
      return v is string && v.size() >= 1 && v.size() <= 128 && v.matches('^[A-Za-z0-9_-]+$');
    }

    function hasEmail(s) {
      return s.matches('(?s).*@.*');
    }

    // Sequenza di almeno 7 caratteri che inizia e finisce con una cifra e contiene solo
    // cifre o separatori tipici dei numeri di telefono (+39 333 123 4567, 333-1234567…).
    function hasPhone(s) {
      return s.matches('(?s).*[0-9][0-9 ./()+-]{5,}[0-9].*');
    }

    // Testo pubblico breve: stringa non vuota, senza email né numeri di telefono.
    function isSafeText(v, maxLen) {
      return v is string
        && v.size() >= 1
        && v.size() <= maxLen
        && !hasEmail(v)
        && !hasPhone(v);
    }

    // @username: minuscole, cifre, punto e trattino basso; niente email (la @ non è
    // ammessa) e niente numeri di telefono (al massimo 6 cifre consecutive).
    function isUsername(v) {
      return v is string
        && v.matches('^[a-z0-9._]{3,30}$')
        && !v.matches('.*[0-9]{7,}.*');
    }

    // URL immagine: solo https, senza spazi né @ (niente credenziali o email nell'URL).
    function isHttpsUrl(v) {
      return v is string && v.size() <= 2048 && v.matches('^https://[^ @]+$');
    }

    function isBase64(v, maxLen) {
      return v is string
        && v.size() > 0
        && v.size() <= maxLen
        && v.matches('^[A-Za-z0-9+/]+={0,2}$');
    }

    function isSchemaV2(d) {
      return d.schemaVersion is int && d.schemaVersion == 2;
    }

    // ─── Profili ────────────────────────────────────────────────────────────

    // Copia pubblica e minima del profilo (il profilo completo è su Supabase).
    function isPublicProfile(d) {
      return d.keys().hasAll(['username', 'publicName', 'updatedAt'])
        && d.keys().hasOnly(['username', 'publicName', 'avatarUrl', 'updatedAt'])
        && isUsername(d.username)
        && isSafeText(d.publicName, 60)
        && d.updatedAt is timestamp
        && (!('avatarUrl' in d) || isHttpsUrl(d.avatarUrl));
    }

    // Un dispositivo push può essere scritto solo dal proprietario del profilo.
    function validPushDevice(deviceId) {
      return deviceId.size() >= 10
        && deviceId.size() <= 128
        && deviceId.matches('^[A-Za-z0-9_-]+$')
        && request.resource.data.keys().hasOnly([
          'platform', 'appVersion', 'enabled', 'createdAt', 'updatedAt', 'lastSeenAt'
        ])
        && request.resource.data.platform in ['android', 'ios']
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 20
        && request.resource.data.enabled == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastSeenAt is timestamp;
    }

    match /profiles/{uid} {
      // Lettura singola rivalidata: i profili legacy con campi privati non sono leggibili.
      allow get: if signedIn() && isPublicProfile(resource.data);
      // Nessuna enumerazione dei profili: la ricerca utenti passa da Supabase.
      allow list: if false;
      allow create, update: if isSelf(uid)
        && isPublicProfile(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // Dispositivi push associati all'account. Il FID è la chiave del
      // documento e non è mai esposto agli altri utenti.
      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create: if isSelf(uid) && validPushDevice(deviceId);
        allow update: if isSelf(uid)
          && validPushDevice(deviceId)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }

    // ─── Chat e membership ──────────────────────────────────────────────────

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function memberPath(chatId, uid) {
      return /databases/$(database)/documents/chats/$(chatId)/members/$(uid);
    }

    function isMember(chatId) {
      return signedIn() && exists(memberPath(chatId, request.auth.uid));
    }

    function myMembership(chatId) {
      return get(memberPath(chatId, request.auth.uid)).data;
    }

    function isChat(d) {
      return d.keys().hasAll(['type', 'createdBy', 'createdAt', 'updatedAt', 'schemaVersion'])
        && d.keys().hasOnly([
          'type', 'createdBy', 'createdAt', 'updatedAt', 'schemaVersion',
          'title', 'avatarUrl', 'lastMessageAt'
        ])
        && d.type in ['direct', 'group']
        && isUid(d.createdBy)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        && isSchemaV2(d)
        && (!('title' in d) || isSafeText(d.title, 80))
        && (!('avatarUrl' in d) || isHttpsUrl(d.avatarUrl))
        && (!('lastMessageAt' in d) || d.lastMessageAt is timestamp);
    }

    // owner: tutti i permessi; member: nessun permesso; admin: permessi a scelta dell'owner.
    function isPermissions(p, role) {
      return p is map
        && p.keys().hasAll(['addMembers', 'removeMembers'])
        && p.keys().hasOnly(['addMembers', 'removeMembers'])
        && p.addMembers is bool
        && p.removeMembers is bool
        && (role != 'owner' || (p.addMembers == true && p.removeMembers == true))
        && (role != 'member' || (p.addMembers == false && p.removeMembers == false));
    }

    function isMembership(d, memberId) {
      return d.keys().hasAll(['uid', 'role', 'permissions', 'joinedAt', 'addedBy', 'schemaVersion'])
        && d.keys().hasOnly(['uid', 'role', 'permissions', 'joinedAt', 'addedBy', 'schemaVersion'])
        && d.uid == memberId
        && isUid(d.uid)
        && d.role in ['owner', 'admin', 'member']
        && isPermissions(d.permissions, d.role)
        && d.joinedAt is timestamp
        && isUid(d.addedBy)
        && isSchemaV2(d);
    }

    function isMessage(d) {
      return d.keys().hasAll([
          'senderId', 'ciphertext', 'iv', 'type', 'createdAt', 'status', 'deletedForAll',
          'schemaVersion'
        ])
        && d.keys().hasOnly([
          'senderId', 'ciphertext', 'iv', 'type', 'createdAt', 'status', 'deletedForAll',
          'schemaVersion', 'replyTo'
        ])
        && isUid(d.senderId)
        && isBase64(d.ciphertext, 65535)
        && isBase64(d.iv, 64)
        && d.type in ['text', 'image', 'video', 'audio', 'file']
        && d.createdAt is timestamp
        && d.status in ['sent', 'delivered', 'read']
        && d.deletedForAll is bool
        && isSchemaV2(d)
        && (!('replyTo' in d) || d.replyTo == null || isUid(d.replyTo));
    }

    match /chats/{chatId} {
      allow get: if isMember(chatId) && isChat(resource.data);
      // L'elenco delle proprie chat si ottiene dalla collection group "members".
      allow list: if false;

      // La chat nasce in un unico batch insieme alla membership "owner" del creatore.
      allow create: if signedIn()
        && isChat(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(memberPath(chatId, request.auth.uid)).data.role == 'owner';

      // Nome e foto del gruppo solo da owner/admin; ultimo messaggio da qualsiasi membro.
      allow update: if isMember(chatId)
        && isChat(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'avatarUrl', 'updatedAt', 'lastMessageAt'])
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'avatarUrl'])
          || myMembership(chatId).role in ['owner', 'admin']);

      allow delete: if false;

      match /members/{memberId} {
        allow get: if isMember(chatId) && isMembership(resource.data, memberId);
        // Le membership esistono solo se scritte con queste regole (prima erano negate).
        allow list: if isMember(chatId);

        allow create: if signedIn()
          && isMembership(request.resource.data, memberId)
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.joinedAt == request.time
          && (
            // 1) Creazione della chat (stesso batch): il creatore è owner, gli altri member.
            (!exists(chatPath(chatId))
              && getAfter(chatPath(chatId)).data.createdBy == request.auth.uid
              && ((memberId == request.auth.uid && request.resource.data.role == 'owner')
                || (memberId != request.auth.uid && request.resource.data.role == 'member')))
            ||
            // 2) Aggiunta o reinvito in un gruppo esistente: owner, oppure admin con
            //    addMembers. Nessuno può aggiungere sé stesso; solo l'owner nomina admin.
            (exists(chatPath(chatId))
              && get(chatPath(chatId)).data.type == 'group'
              && memberId != request.auth.uid
              && isMember(chatId)
              && myMembership(chatId).role in ['owner', 'admin']
              && myMembership(chatId).permissions.addMembers == true
              && (request.resource.data.role == 'member'
                || (request.resource.data.role == 'admin' && myMembership(chatId).role == 'owner')))
          );

        // Solo l'owner cambia ruoli e permessi; il ruolo owner non si assegna né si toglie.
        allow update: if isMember(chatId)
          && myMembership(chatId).role == 'owner'
          && resource.data.role != 'owner'
          && isMembership(request.resource.data, memberId)
          && request.resource.data.role in ['admin', 'member']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'permissions']);

        // Uscita volontaria, oppure rimozione da owner o da admin con removeMembers
        // (un admin rimuove solo i member). L'owner non può essere rimosso.
        allow delete: if signedIn()
          && resource.data.role != 'owner'
          && (memberId == request.auth.uid
            || (isMember(chatId)
              && (myMembership(chatId).role == 'owner'
                || (myMembership(chatId).role == 'admin'
                  && myMembership(chatId).permissions.removeMembers == true
                  && resource.data.role == 'member'))));
      }

      match /messages/{messageId} {
        allow get: if isMember(chatId) && isMessage(resource.data);
        // La query deve filtrare where('schemaVersion', '==', 2).
        allow list: if isMember(chatId) && resource.data.schemaVersion == 2;

        // Solo payload cifrato, del mittente autenticato.
        allow create: if isMember(chatId)
          && isMessage(request.resource.data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.status == 'sent'
          && request.resource.data.deletedForAll == false;

        // I destinatari aggiornano solo lo stato; il mittente solo "elimina per tutti".
        allow update: if isMember(chatId)
          && isMessage(request.resource.data)
          && ((resource.data.senderId != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
            || (resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedForAll'])
              && request.resource.data.deletedForAll == true));

        allow delete: if isMember(chatId) && resource.data.senderId == request.auth.uid;
      }
    }

    // Elenco delle proprie membership in tutte le chat:
    // collectionGroup('members').where('uid', '==', <mio uid>).
    match /{path=**}/members/{memberId} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ─── Richieste di messaggio ─────────────────────────────────────────────

    function isMessageRequest(d) {
      return d.keys().hasAll(['from', 'to', 'status', 'createdAt', 'schemaVersion'])
        && d.keys().hasOnly(['from', 'to', 'status', 'createdAt', 'updatedAt', 'schemaVersion'])
        && isUid(d.from)
        && isUid(d.to)
        && d.from != d.to
        && d.status in ['pending', 'accepted', 'declined']
        && d.createdAt is timestamp
        && (!('updatedAt' in d) || d.updatedAt is timestamp)
        && isSchemaV2(d);
    }

    function isRequestParty(d) {
      return signedIn() && (d.from == request.auth.uid || d.to == request.auth.uid);
    }

    // Richieste di messaggio dagli sconosciuti: il destinatario accetta o rifiuta.
    match /messageRequests/{requestId} {
      allow get: if isRequestParty(resource.data) && isMessageRequest(resource.data);
      // La query deve filtrare su from o to == mio uid e schemaVersion == 2.
      allow list: if isRequestParty(resource.data) && resource.data.schemaVersion == 2;

      allow create: if signedIn()
        && isMessageRequest(request.resource.data)
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && !('updatedAt' in request.resource.data);

      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && isMessageRequest(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // Tutto il resto è chiuso per impostazione predefinita.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
