rules_version = '2';

// Nexus Social — regole Firestore (Fase 1, pronte per la Fase 4).
//
// Principi:
//  • le chat contengono solo testo cifrato lato dispositivo (ciphertext + iv): nessun
//    messaggio in chiaro viene mai scritto o letto dal server;
//  • solo i membri della chat possono leggere o scrivere i messaggi;
//  • i profili su Firestore sono una copia minima e pubblica (nome abbreviato, @username,
//    avatar) usata da chat, chiamate e notifiche;
//  • nessun client può cancellare una chat o modificare l'elenco dei membri di un'altra persona.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Un dispositivo push può essere scritto solo dal proprietario del profilo.
    function validPushDevice(deviceId) {
      return deviceId.size() >= 10
        && deviceId.size() <= 128
        && deviceId.matches('^[A-Za-z0-9_-]+$')
        && request.resource.data.keys().hasOnly([
          'platform', 'appVersion', 'enabled', 'createdAt', 'updatedAt', 'lastSeenAt'
        ])
        && request.resource.data.platform in ['android', 'ios']
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 20
        && request.resource.data.enabled == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastSeenAt is timestamp;
    }

    function chatMembers(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    function isChatMember(chatId) {
      return signedIn() && request.auth.uid in chatMembers(chatId);
    }

    // Copia pubblica e minima del profilo, usata da chat e notifiche.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'publicName', 'avatarUrl', 'updatedAt']);
      allow delete: if false;

      // Dispositivi push associati all'account. Il FID è la chiave del
      // documento e non è mai esposto agli altri utenti.
      match /devices/{deviceId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validPushDevice(deviceId);
        allow update: if isOwner(uid)
          && validPushDevice(deviceId)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }

    match /chats/{chatId} {
      allow read: if isChatMember(chatId);
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 256;
      allow update: if isChatMember(chatId)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 256;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);

        // Solo payload cifrato, del mittente autenticato, con dimensione massima.
        allow create: if isChatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'senderId', 'ciphertext', 'iv', 'type', 'createdAt', 'status', 'replyTo', 'deletedForAll'
          ])
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() > 0
          && request.resource.data.ciphertext.size() < 65536;

        // I destinatari possono aggiornare solo stato di consegna/lettura e reazioni.
        allow update: if isChatMember(chatId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedForAll']);

        // Elimina per tutti solo dal mittente.
        allow delete: if isChatMember(chatId) && resource.data.senderId == request.auth.uid;
      }
    }

    // Richieste di messaggio dagli sconosciuti: si accettano o si rifiutano.
    match /messageRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.keys().hasOnly(['from', 'to', 'status', 'createdAt']);
      allow read, update: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow delete: if false;
    }

    // Tutto il resto è chiuso per impostazione predefinita.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
