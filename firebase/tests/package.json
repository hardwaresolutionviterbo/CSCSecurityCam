{
  "name": "nexus-social-firestore-rules-tests",
  "private": true,
  "description": "Test permanenti delle regole Firestore di Nexus Social (Firestore Emulator).",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "firebase emulators:exec --config ../../firebase.json --only firestore --project demo-nexus-social \"node --test --test-reporter=spec rules.test.mjs\"",
    "check": "node --check rules.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.3.0",
    "firebase-tools": "15.36.0"
  }
}
