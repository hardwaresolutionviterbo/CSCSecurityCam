<?xml version="1.0" encoding="utf-8"?>
<!--
  Lo streaming LAN usa HTTP in chiaro (http://<ip>:8765/live.mjpg, /status, /snapshot):
  con targetSdk 36 Android blocca il cleartext di default e LanStreamClient fallirebbe con
  "CLEARTEXT communication not permitted by network security policy".

  Il telefono videocamera viene raggiunto tramite un indirizzo IP privato scelto a runtime
  nella rete Wi-Fi locale, quindi non è possibile elencarlo in un <domain-config> (che accetta
  solo nomi host, non intervalli di IP): il permesso va concesso nella base-config.

  Questo consente il traffico HTTP non cifrato verso qualsiasi host: va ristretto o rimosso
  quando il trasporto passerà a WebRTC/DTLS con cifratura. Usare solo su reti Wi-Fi fidate.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
